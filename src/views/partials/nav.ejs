<%
const safeActive = typeof active !== 'undefined' ? active : '';
const appLabel = typeof appName !== 'undefined' && appName ? appName : '基金模拟工具';
const navItems = [
  { key: 'dashboard', href: '/', label: '总览' },
  { key: 'account', href: '/account', label: '账户' },
  { key: 'operations', href: '/operations', label: '操作' },
  { key: 'pnl', href: '/pnl', label: '盈亏' }
];
%>
<header class="topbar">
  <a class="brand" href="/" aria-label="返回总览">
    <span class="brand-mark">基</span>
    <span>
      <strong><%= appLabel %></strong>
      <small>基金模拟账本</small>
    </span>
  </a>
  <nav class="nav-links" aria-label="主导航">
    <% navItems.forEach((item) => { %>
      <a class="<%= safeActive === item.key ? 'is-active' : '' %>" href="<%= item.href %>"><%= item.label %></a>
    <% }) %>
  </nav>
</header>
